{
    "vcTemplate": "",
    "credentialConfigKeyId": "MOSIPVerifiableCredential",
    "contextURLs": [
        "https://inji.github.io/inji-config/contexts/mosip-identity-context.json",
        "https://www.w3.org/2018/credentials/v1"
    ],
    "credentialTypes": [
        "MOSIPVerifiableCredential",
        "VerifiableCredential"
    ],
    "credentialFormat": "ldp_vc",
    "didUrl": "did:web:inji.github.io:inji-config:dev-int-inji:mosipid-identity",
    "keyManagerAppId": "CERTIFY_VC_SIGN_EC_K1",
    "keyManagerRefId": "EC_SECP256K1_SIGN",
    "signatureAlgo": "ES256K",
    "signatureCryptoSuite": "EcdsaSecp256k1Signature2019",
    "metaDataDisplay": [
        {
            "logo": {
                "url": "https://inji.github.io/inji-config/logos/mosipid-logo.png",
                "alt_text": "a square logo of a MOSIP"
            },
            "name": "MOSIP National ID",
            "locale": "en",
            "text_color": "#FFFFFF",
            "background_color": "#12107c",
            "background_image": {
                "uri": "https://inji.github.io/inji-config/vcbackground/default-background.png"
            }
        }
    ],
    "displayOrder": [
        "fullName",
        "phone",
        "dateOfBirth",
        "gender",
        "residenceStatus",
        "email",
        "region",
        "province",
        "city",
        "UIN",
        "VID",
        "postalCode"
    ],
    "scope": "mosip_identity_vc_ldp",
    "qrSettings": [
        {
            "Face": {
                "Data": "$rootContext.get('compressedPicture')",
                "Data format": "Image",
