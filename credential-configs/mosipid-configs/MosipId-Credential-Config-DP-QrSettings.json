            },
            "Full Name": "$rootContext.get('name#en')",
            "Phone Number": "$rootContext.get('phone_number')",
            "Date Of Birth": "$rootContext.get('birthdate')"
        }
    ],
    "qrSignatureAlgo": "EdDSA",
