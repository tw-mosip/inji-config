{
	"@context": [
	  "https://www.w3.org/2018/credentials/v1",
	  "https://piyush7034.github.io/context-schema/multilang-credential-context.json",
	  "https://w3id.org/security/suites/ed25519-2020/v1"
	],
	"issuer": "${_issuer}",
	"type": [
	  "VerifiableCredential",
	  "FarmerCredential"
	],
	"issuanceDate": "${validFrom}",
	"expirationDate": "${validUntil}",
	"credentialSubject": {
	  "id": "${_holderId}",
	  "authority": "${authority}",
	  "idType": "${idType}",
	  "fullName": ${fullName},
	  "farmerId": "${farmerId}",
	  "gender": ${gender},
	  "phoneNumber": "${phoneNumber}",
	  "dateOfBirth": "${dateOfBirth}",
	  "address": {
          "type": "PostalAddress",
		  "village": "${address_village}",
		  "district": "${address_district}",
          "state": "${address_state}"
	  },
      "farm": {
        "type": "Farm",
        "primaryCommodity": "${primaryCommodity}",
        "totalLandArea": {
            "value": ${totalLandArea_value},
            "unit": "${totalLandArea_unit}"
        },
        "ownershipType": "${ownershipType}",
        "crops": ${crops}
      }
	}
  }